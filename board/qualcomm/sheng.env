# This file IS the environment (CONFIG_ENV_IS_NOWHERE +
# CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE), so bootdelay here overrides
# CONFIG_BOOTDELAY.
#
# A port of board/qualcomm/xiaomi-marble.env with the USB-shaped parts removed
# -- this board has no UART and no USB gadget stack in U-Boot, so marble's
# serial shell, UMS and bootloader-fastboot entries have nothing behind them.
#
# The image holds no OS knowledge at all. It finds an extlinux.conf on the FAT
# partition labelled "esp", hands the boot to it, and gets out of the way.
# Which kernel, which root, which other systems -- all of that is decided by
# files on the ESP, never here, so nothing needs rebuilding to change it.
#
# 0 so bootcmd reaches the menu immediately. This is not the menu's timeout
# (bootmenu_delay is); it is main_loop()'s "hit any key to stop autoboot", and
# a button press during it drops to a prompt that three buttons cannot type at.
bootdelay=0
# Positive, with CONFIG_BOOT_RETRY + CONFIG_RETRY_BOOTCMD: a failed entry
# returns to the shell, which times out and re-runs bootcmd. bootcmd rewrites
# itself to menucmd on the way in, so the retry lands in a menu that never
# times out instead of at a prompt nothing can type at.
bootretry=1
# nulldev FIRST. A bare "button-kbd" that fails to probe leaves the board with
# no stdin and it will not boot; recovery is fastboot. nulldev always binds,
# and CONSOLE_MUX polls the whole list so the buttons still work.
#
# No "serial": the debug UART is not connected and its floating RX reads as
# random characters, which selects a menu entry instantly.
stdin=nulldev,button-kbd
stdout=vidconsole
stderr=vidconsole

# Nothing else sets these. All inside the 0x811d0000-0x88000000 bank and clear
# of every reserved-memory carveout in it.
kernel_addr_r=0x83000000
fdt_addr_r=0x86000000
pxefile_addr_r=0x87000000
scriptaddr=0x87000000
ramdisk_addr_r=0x87100000

# Always probe UFS, then let the one-shot selection on the ESP take effect
# before the countdown starts.
preboot=scsi scan; run others_next

# NORMAL PATH. The file and every payload it names live on the ESP; the
# kernel/fdt lines inside it are relative to the ESP root, so where they sit is
# the installed system's choice.
#
# ROOT IS DECIDED BY THE FILE: each LABEL carries its own `append root=...`.
# That is what makes dual-boot work without touching this image -- a second OS
# is another LABEL, or another partition named from others.env.
bootlinux=part number scsi 0 esp esp_part && sysboot scsi 0:${esp_part} any ${pxefile_addr_r} /extlinux/extlinux.conf

# Runtime menu configuration, same protocol as marble's /extlinux/others.env:
# hand-managed on the ESP, imported with a whitelist because an unrestricted
# import can redefine bootcmd and brick the boot. Read by others_next before
# the countdown, and again by others_menu when the submenu is opened.
#
# File format, one variable per line, same as mkenvimage. The label and path in
# next_boot belong to the other OS, not to this image:
#     next_title=Other OS
#     next_boot=part number scsi 0 <label> p; sysboot scsi 0:${p} any ${pxefile_addr_r} /extlinux/extlinux.conf
#     bootmenu_0=Other OS=run next_boot
#
# Dual-boot can also share one ESP and one file, selecting a LABEL by name --
# that is what pxe_label_override is for, and it is the only way to pick a
# label other than DEFAULT without typing (pxe_utils' menu wants digits):
#     next_boot=part number scsi 0 esp p; setenv pxe_label_override other; sysboot scsi 0:${p} any ${pxefile_addr_r} /extlinux/extlinux.conf
others_file=part number scsi 0 esp esp_part && load scsi 0:${esp_part} ${scriptaddr} /extlinux/others.env
# Indices stay contiguous from 0: cmd/bootmenu.c stops at the first gap. The
# static entries below are 0..5, so the way back to the default boot is 6.
others_next=if run others_file; then env import -t ${scriptaddr} ${filesize} next_title next_boot; if test -n "${next_boot}"; then setenv bootmenu_0 "${next_title} (one-shot)=run next_boot; pause"; setenv bootmenu_6 "Boot=run bootlinux; pause"; fi; fi
# Submenu. Delete more indices than the file could define, then import the
# first ten it does; anything beyond is left to the fallback above.
others_menu=if run others_file; then env delete -f bootmenu_0 bootmenu_1 bootmenu_2 bootmenu_3 bootmenu_4 bootmenu_5 bootmenu_6 bootmenu_7 bootmenu_8 bootmenu_9 bootmenu_10 bootmenu_11 bootmenu_12 bootmenu_13 bootmenu_14 bootmenu_15 bootmenu_16 bootmenu_17 bootmenu_18 bootmenu_19 bootmenu_20; env import -t ${scriptaddr} ${filesize} bootmenu_0 bootmenu_1 bootmenu_2 bootmenu_3 bootmenu_4 bootmenu_5 bootmenu_6 bootmenu_7 bootmenu_8 bootmenu_9; bootmenu; else echo "no /extlinux/others.env on the esp"; pause; fi; reset

# Static menu. With no others.env these six are the whole menu: a way to boot,
# a way to reach a second OS, and a way into fastboot.
bootmenu_0=Boot=run bootlinux; pause
bootmenu_1=Other systems...=run others_menu
# Reboot into ABL's fastboot.
#
# Qualcomm does not use the Android BCB/misc handshake here: the bcb write
# succeeds and ABL boots straight past it. The mechanism is a magic cookie in
# IMEM, read after the reset. Address from the stock Android DTB, which is what
# ABL actually looks at:
#
#     qcom,msm-imem@146aa000 {
#             restart_reason@65c { reg = <0x65c 0x04>; };
#
# so 0x146aa000 + 0x65c = 0x146aa65c, and 0x77665500 is the
# boot-to-bootloader value. (Mainline's sm8550.dtsi describes a DIFFERENT imem
# at 0x14680000 -- do not use that one.)
#
# The one reset-shaped entry that is safe: it lands in fastboot, a terminal
# recoverable state, and ABL clears the cookie when it honours it. The "NEVER
# ADD A reset ENTRY" rule below still holds for plain resets.
#
# Not U-Boot's own fastboot: this build has no USB gadget stack.
bootmenu_2=Reboot to fastboot (bootloader)=run rebootfastboot
rebootfastboot=mw.l 0x146aa65c 0x77665500 && reset
# NEVER ADD A "reset" ENTRY. A stuck button selects it, the board reboots into
# the menu, and selects it again -- a loop only fastboot breaks.
#
# Finite on purpose: -1 waits forever, stranding the boot if the buttons fail
# to bind.
bootmenu_delay=5
bootmenu_3=Dump environment=printenv; pause
bootmenu_4=Board info=bdinfo; pause
bootmenu_5=Dump bootargs=fdt addr ${fdt_addr_r}; fdt print /chosen bootargs; pause
# No "Power off" entry: CONFIG_CMD_POWEROFF is not set in sm8550_defconfig and
# there is no poweroff command to call.

# Allow holding the volume down button while U-Boot loads to enter the boot
# menu without racing the countdown (CONFIG_BUTTON_CMD).
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd

# When entering the menu (either from button press or failed boot) remap
# bootcmd so it will re-open the menu and we won't get stuck at the console
# with no way to type
menucmd=setenv bootcmd run menucmd; bootmenu -1

# No load step here: preboot already ran others_next, so bootcmd is just the
# countdown. This is marble's line unchanged.
bootcmd=setenv bootcmd run menucmd; bootmenu 5
